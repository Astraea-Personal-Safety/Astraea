# ==============================================================================
# Astraea - Personal Safety Platform Environment Configuration Template
# ==============================================================================

# Bolna Voice AI Credentials
BOLNA_API_KEY=bn-your-bolna-api-key
BOLNA_CHECKIN_AGENT_ID=your-checkin-agent-uuid
BOLNA_ALERT_AGENT_ID=your-alert-agent-uuid

# Optional shared secret for the Bolna webhook. If set, configure the Bolna agents' webhook as
#   https://<your-domain>/api/bolna/webhook?secret=<this value>
BOLNA_WEBHOOK_SECRET=

# Safety Rails & Simulation Modes
BOLNA_DRY_RUN=false
VERIFIED_PHONE_NUMBERS=+91XXXXXXXXXX

# Persistent storage for sessions / tracking / call results (optional but needed on Vercel for
# /track/:id to work across serverless instances). Create a free Upstash Redis database (or add
# Vercel KV from the Marketplace) and paste the REST URL + token. Either naming works:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Emergency Gateways (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CALLMEBOT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WhatsApp sender for Twilio (e.g. +14155238886 sandbox); falls back to TWILIO_PHONE_NUMBER
TWILIO_WHATSAPP_NUMBER=
# The server-side WhatsApp relay only delivers to numbers listed in VERIFIED_PHONE_NUMBERS

# Gemini Safety Reasoning API (Optional)
VITE_GEMINI_API_KEY=
